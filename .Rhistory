mpcls <- function(y, x) {
dm <- dim(x)
n <- dm[1]   ;   p <- dm[2]
d <- dim(y)[2]
xtx <- crossprod(x)
xty <- crossprod(x, y)
be <- matrix(nrow = p, ncol = d)
for ( j in 1:d )  be[, j] <- as.matrix( nnsolve::fnnls(xtx, xty[, j]) )
mse <- Rfast::colmeans( (y - x %*% be)^2 )
rownames(be) <- colnames(x)
list(be = be, mse = mse)
}
test <- fnnls_cols(Y,X)
true <- mpcls( Y, X)
all.equal(test$B,true$be )
all.equal(test$mse, true$mse)
n <- 500
p <- 20
X <- matrix(rnorm(n * p), nrow = n, ncol = p)
y <- runif(n)
test <- nnsolve::fnnls_reg(y, X)
mpcls_reg <- function(y, x) {
dm <- dim(x)
n <- dm[1]   ;   p <- dm[2]
d <- dim(y)[2]
xtx <- crossprod(x)
xty <- t(x) %*% y
be <-nnsolve::fnnls(xtx, xty)
mse <- mean((y - x %*% be)^2)
list(be = be, mse = mse)
}
true <-mpcls_reg(y, X)
all.equal(true$mse, test$mse)
all.equal(test$b, true$be)
