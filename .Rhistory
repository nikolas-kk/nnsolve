mpcls <- function(y, x) {
dm <- dim(x)
n <- dm[1]   ;   p <- dm[2]
d <- dim(y)[2]
xtx <- crossprod(x)
xty <- crossprod(x, y)
be <-nnsolve::fnnls(xtx, xty)
mse <- mean((y - x %*% be)^2)
list(be = be, mse = mse)
}
mpcls_reg <- function(y, x) {
dm <- dim(x)
n <- dm[1]   ;   p <- dm[2]
d <- dim(y)[2]
xtx <- crossprod(x)
xty <- crossprod(x, y)
be <-nnsolve::fnnls(xtx, xty)
mse <- mean((y - x %*% be)^2)
list(be = be, mse = mse)
}
true <-mpcls_reg(y, X)
mpcls_reg <- function(y, x) {
dm <- dim(x)
n <- dm[1]   ;   p <- dm[2]
d <- dim(y)[2]
xtx <- crossprod(x)
xty <- x.t() * y
be <-nnsolve::fnnls(xtx, xty)
mse <- mean((y - x %*% be)^2)
list(be = be, mse = mse)
}
true <-mpcls_reg(y, X)
