library(nnsolve)
n <- 50
p <- 20
m <- 10
X <- matrix(rnorm(n * p), nrow = n, ncol = p)
Y <- matrix(runif(n * m, min = 0, max = 10), nrow = n, ncol = m)
y <- runif(n)
test <- fnnls_cols(Y, X, sum_to_constant =  TRUE)
fnnls_cols_R<- function(Y, X){
B <- matrix(nrow = ncol(X), ncol = ncol(Y))
Xt <- t(X)
XtX <- crossprod(X)
XtY <- crossprod(X,Y)
for(i in seq(1, ncol(Y))){
Xty <- as.vector(Xt %*% Y[,i])
B[,i] = fnnls(XtX, XtY[,i])
}
B
}
mpcls <- function(y, x) {
dm <- dim(x)
n <- dm[1]   ;   p <- dm[2]
d <- dim(y)[2]
xtx <- crossprod(x)
xty <- crossprod(x, y)
be <- matrix(nrow = p, ncol = d)
for ( j in 1:d )  be[, j] <- as.matrix( nnsolve::fnnls(xtx, xty[, j], sum_to_constant = TRUE) )
mse <- Rfast::colmeans( (y - x %*% be)^2 )
rownames(be) <- colnames(x)
list(be = be, mse = mse)
}
true <- fnnls_cols_R(Y,X)
true2 <- mpcls( Y, X)
true2
true
all.equal(test,true2 )
true <- fnnls_cols(Y,X)
all.equal(test$B,true2$be )
all.equal(test$mse, true2$mse)
true <- fnnls_cols(Y,X)
true2 <- mpcls( Y, X)
all.equal(test$B,true2$be )
all.equal(test$mse, true2$mse)
microbenchmark::microbenchmark(fnnls_cols(Y,X), mpcls(Y,X),times = 15)
microbenchmark::microbenchmark(fnnls_cols(Y,X), mpcls(Y,X),times = 150)
